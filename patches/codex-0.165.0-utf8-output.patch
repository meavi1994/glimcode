 }
+
+#[test]
+fn truncated_large_utf8_tree_preserves_branch_characters() {
+    let tree = (0..60000)
+        .map(|i| format!("│   ├── file-{i}.rs\n"))
+        .collect::<String>();
+    for limit in [65536, 1024 * 1024] {
+        for cap in limit - 16..limit + 16 {
+            let bytes = &tree.as_bytes()[..cap];
+            assert_eq!(decode_shell_output(bytes), String::from_utf8_lossy(bytes));
+        }
+    }
+}
+
+#[test]
+fn truncated_utf8_multibyte_suffix_preserves_valid_prefix() {
+    for ending in ["├", "é", "😀"] {
+        let text = format!("日本語 and café: {ending}");
+        for missing in 1..ending.len() {
+            let bytes = &text.as_bytes()[..text.len() - missing];
+            assert_eq!(decode_shell_output(bytes), String::from_utf8_lossy(bytes));
+        }
+    }
+}
